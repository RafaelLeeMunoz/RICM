---
layout: base.njk
title: "Learn at RICM — STEM Programs"
---
{% import "macros.njk" as m %}
<section class="hero" data-surface="dark">
  <div class="hero-media"><img src="{% placeholderImage "learn-hero", 1600, 900 %}" alt=""></div>
  <div class="container hero-inner">
    <div>
      {{ m.breadcrumb([["Home", "/"], ["Learn", "/learn/"]]) }}
      <span class="eyebrow hero-eyebrow c-teal">Learn</span>
      <h1>Learn today. Create tomorrow.</h1>
      <p class="lede">Hands-on STEM programs that spark curiosity, build skills, and inspire the next generation of innovators.</p>
      <div class="hero-ctas">
        <a class="btn btn-teal" href="#learn-finder">Find a Program</a>
        <a class="btn btn-outline" href="#schools">For Educators</a>
      </div>
    </div>
    <div class="hero-art"><img src="{% placeholderImage "learn-hero-art", 900, 700 %}" alt="Two students building a robot together at RICM."></div>
  </div>
</section>

<div class="container">
  <div class="finder-panel" id="learn-finder">
    <span class="eyebrow">Program Finder</span>
    <h2 style="margin:.3em 0 var(--space-5);">What are you looking for?</h2>
    <form id="learn-finder-form">
      <div class="finder-grid">
        <div class="finder-group">
          <h3>Age / Grade</h3>
          <div class="filter-options stacked">
            {% for b in ageBands %}
            <label class="check-row"><input type="checkbox" name="age" value="{{ b.id }}"> Ages {{ b.label }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="finder-group">
          <h3>Interest</h3>
          <div class="filter-options stacked">
            {% for i in interests %}
            <label class="check-row"><input type="checkbox" name="interest" value="{{ i.id }}"> {{ i.label }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="finder-group">
          <h3>Location</h3>
          <div class="filter-options stacked">
            {% for l in locations %}
            <label class="check-row"><input type="checkbox" name="location" value="{{ l.id }}"> {{ l.label }}</label>
            {% endfor %}
          </div>
        </div>
        <div class="finder-actions"><button type="submit" class="btn btn-primary btn-block">Show Programs {% icon "arrowRight" %}</button></div>
      </div>
    </form>
  </div>
</div>

<section class="section-pad bg-white"><div class="container">
  <span class="eyebrow">Choose Your Path</span>
  <h2 style="margin-top:.4em;margin-bottom:var(--space-6);">I'm a…</h2>
  <div class="audience-grid">
    {% set audiences = [
      { title: "Family", sub: "Activities & camps for curious kids and parents.", ic: "users", href: "/learn/#families", seed: "learn-family" },
      { title: "Educator", sub: "Bring engaging STEM learning to your classroom.", ic: "graduationCap", href: "/learn/#schools", seed: "learn-educator" },
      { title: "Community Group", sub: "Plan a field trip, workshop, or event together.", ic: "compass", href: "/learn/#community", seed: "learn-community" },
      { title: "Homeschool", sub: "Flexible programs that fit your learning goals.", ic: "home", href: "/learn/#homeschool", seed: "learn-homeschool" }
    ] %}
    {% for a in audiences %}
    <a class="audience-card" href="{{ a.href }}">
      <img src="{% placeholderImage a.seed, 500, 320 %}" alt="">
      <div class="ac-body">{% icon a.ic %}<strong>{{ a.title }}</strong><span>{{ a.sub }}</span></div>
    </a>
    {% endfor %}
  </div>
</div></section>

<section class="section-pad-sm bg-warm"><div class="container">
  <div class="section-head">
    <div class="section-title-group"><span class="eyebrow c-teal">Popular Now</span><h2>Featured programs</h2></div>
    <a class="text-link" href="/programs/">View all programs {% icon "arrowRight" %}</a>
  </div>
  <div class="card-grid cols-3">
    {% for p in featuredPrograms %}
    {{ m.programCard(p) }}
    {% endfor %}
  </div>
</div></section>

<section class="section-pad bg-navy" id="schools"><div class="container">
  <div class="two-col" style="align-items:center;">
    <div>
      <span class="eyebrow">For Schools &amp; Educators</span>
      <h2 style="margin-top:.4em;">Bring RICM to your students.</h2>
      <p class="lede" style="margin-top:var(--space-4);">Compare grade levels, learning outcomes, group sizes, and on-campus or in-school formats — all built around your classroom's needs.</p>
      <div class="stat-row" style="margin-top:var(--space-6);grid-template-columns:repeat(2,1fr);">
        <div class="stat-item" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.15);"><div class="num" style="color:#fff;">{% icon "check" %}</div><div class="lbl" style="color:#B9C6DA;">Standards aligned</div></div>
        <div class="stat-item" style="background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.15);"><div class="num" style="color:#fff;">{% icon "wrench" %}</div><div class="lbl" style="color:#B9C6DA;">Hands-on learning</div></div>
      </div>
      <a class="btn btn-teal" style="margin-top:var(--space-6);" href="/about/#contact">Request a School Program</a>
    </div>
    <div class="hero-art"><img src="{% placeholderImage "learn-schools", 900, 700 %}" alt="A RICM educator leading a classroom lesson."></div>
  </div>
</div></section>

<section class="section-pad-sm bg-white"><div class="container">
  <div class="cta-band">
    <div><h2>Fuel creativity with Create</h2><p>Explore digital art, animation, music, and more inside RICM's Create hub — the home of Tales from the Hard Drive.</p></div>
    <div class="cta-band-actions">
      <a class="btn btn-teal" href="/create/">Explore Create</a>
    </div>
  </div>
</div></section>
