{# Shared template helpers — the Nunjucks equivalent of site.html's small
   shared render functions (breadcrumb(), etc., see CLAUDE.md). Import into
   any page template with:
     {% import "macros.njk" as m %}
     {{ m.breadcrumb([["Home", "/"], ["Visit", "/visit/"]]) }}
   The LAST item in the trail is rendered as the current page (plain text,
   aria-current="page"), matching site.html's breadcrumb() behavior — its
   href is never used. #}

{% macro breadcrumb(trail, onLight) %}
<nav class="breadcrumb" data-on="{{ 'light' if onLight else 'dark' }}" aria-label="Breadcrumb"><ol>
  {% for item in trail %}
  {% if not loop.last %}
  <li><a href="{{ item[1] }}">{{ item[0] }}</a>{% icon "chevronRight" %}</li>
  {% else %}
  <li aria-current="page">{{ item[0] }}</li>
  {% endif %}
  {% endfor %}
</ol></nav>
{% endmacro %}

{# Ported from site.html's artifactStatusBadge() -- the small pill shown on an
   artifact's thumbnail (On Display / In Restoration / Archived). #}
{% macro artifactStatusBadge(status) %}
  {% set badgeMap = {
    "On Display": { cls: "is-ondisplay", ic: "checkCircle" },
    "In Restoration": { cls: "is-limited", ic: "wrench" },
    "Archived": { cls: "is-archive", ic: "archive" }
  } %}
  {% set s = badgeMap[status] or badgeMap["Archived"] %}
  <span class="status-badge {{ s.cls }}">{% icon s.ic %}{{ status }}</span>
{% endmacro %}

{# Ported from site.html's artifactCard(a) -- the collection-grid card used on
   Explore and (later) Collection list/detail pages. `a` is one entry from
   _data/artifacts.json. #}
{% macro artifactCard(a) %}
<a class="obj-card" href="/collection/{{ a.slug }}/">
  <div class="thumb-wrap">
    <img src="{% placeholderImage a.imageSeeds[0], 900, 700 %}" alt="" loading="lazy">
    <div class="thumb-badges">{{ artifactStatusBadge(a.status) }}</div>
  </div>
  <div class="obj-card-body">
    <h3>{{ a.name }}</h3>
    <div class="obj-meta">
      <span>{% icon "calendar" %} {{ a.year }}</span>
      <span>{{ a.manufacturer }}</span>
    </div>
    <p class="desc">{{ a.summary }}</p>
  </div>
  <div class="obj-card-actions"><span class="text-link">View Object {% icon "arrowRight" %}</span></div>
</a>
{% endmacro %}

{# Ported from site.html's eventCard(ev). #}
{% macro eventCard(ev) %}
<a class="obj-card" href="/events/{{ ev.slug }}/">
  <div class="thumb-wrap">
    <img src="{% placeholderImage ev.imageSeed, 1000, 650 %}" alt="" loading="lazy">
    <div class="thumb-badges">{% if ev.status == "past" %}<span class="tag" style="background:#fff;color:#33383F;">Past Event</span>{% endif %}</div>
  </div>
  <div class="obj-card-body">
    <div class="obj-meta"><span>{% icon "calendar" %} {{ ev.date | formatDate }}</span><span>{% icon "clock" %} {{ ev.time }}</span></div>
    <h3>{{ ev.title }}</h3>
    <div class="obj-meta"><span>{{ ev.audience }}</span><span>{% icon "pin" %} {{ ev.location }}</span></div>
    <p class="desc">{{ ev.desc }}</p>
  </div>
  <div class="obj-card-actions"><span class="text-link">{{ "View Recap" if ev.status == "past" else "View Event" }} {% icon "arrowRight" %}</span></div>
</a>
{% endmacro %}

{# Ported from site.html's emptyState(title, msg, ctaLabel, ctaAction) -- the original's
   ctaAction parameter was never actually wired to anything (every call site hardcoded its
   click target via a separate after() handler); this version takes a real ctaHref instead,
   so the CTA is a plain link and genuinely reusable with no extra JS needed. #}
{% macro emptyState(title, msg, ctaLabel, ctaHref) %}
<div class="state-block">
  <div class="state-icon">{% icon "zoom" %}</div>
  <h3>{{ title }}</h3>
  <p>{{ msg }}</p>
  {% if ctaLabel and ctaHref %}
  <a class="btn btn-primary" href="{{ ctaHref }}">{{ ctaLabel }}</a>
  {% endif %}
</div>
{% endmacro %}

{# Ported from site.html's programCard(p, saved). `saved` is always rendered false
   here (there's no per-visitor knowledge at BUILD time) -- main.js corrects the
   save-button's aria-pressed/label/icon fill from localStorage once the page
   loads in that specific visitor's browser. #}
{% macro programCard(p) %}
<div class="obj-card">
  <a href="/programs/{{ p.slug }}/" style="text-decoration:none;color:inherit;">
    <div class="thumb-wrap">
      <img src="{% placeholderImage p.imageSeed, 1000, 700 %}" alt="" loading="lazy">
      <div class="thumb-badges"><span class="tag tag-teal">Ages {{ p.ageRange }}</span></div>
    </div>
  </a>
  <div class="obj-card-body">
    <button type="button" class="save-btn" aria-pressed="false" data-save-program="{{ p.id }}" aria-label="Save program" style="position:static;margin-left:auto;order:-1;">{% icon "bookmark" %}</button>
    <a href="/programs/{{ p.slug }}/" style="text-decoration:none;color:inherit;">
      <h3>{{ p.title }}</h3>
      <div class="obj-meta">
        <span>{% icon "clock" %} {{ p.duration }}</span>
        <span>{% icon "pin" %} {{ p.locationFormats[0] | locationLabel }}</span>
      </div>
      <p class="desc">{{ p.summary }}</p>
    </a>
  </div>
  <div class="obj-card-foot" style="padding:0 var(--space-4) var(--space-4);">
    <span class="price">${{ p.price }}</span>
    <a class="btn btn-outline btn-sm" href="/programs/{{ p.slug }}/">View Program</a>
  </div>
</div>
{% endmacro %}
